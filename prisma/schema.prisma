generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}




datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  number_id      Int      @id @default(autoincrement())
  text_email     String   @unique
  text_password  String
  text_name      String?
  text_createdAt DateTime @default(now())
  text_updatedAt DateTime @updatedAt

  @@map("users")
}

model Page {
  number_id            Int      @id @default(autoincrement())
  number_parent_id     Int?
  checkbox_published   Boolean  @default(false)
  text_titre           String   @db.VarChar(150)
  text_slug            String   @unique @db.VarChar(150)
  number_page_position Int
  text_langue          String   @db.VarChar(10)
  blocs                String
  text_createdAt       DateTime @default(now())
  text_updatedAt       DateTime @updatedAt
  text_description     String?  @db.VarChar(255)
  checkbox_home_page   Boolean  @default(false)
  parent               Page?    @relation("PageHierarchy", fields: [number_parent_id], references: [number_id], onDelete: Cascade)
  children             Page[]   @relation("PageHierarchy")

  @@index([number_parent_id])
  @@index([text_slug])
  @@map("pages")
}

model Header {
  number_id           Int     @id @default(autoincrement())
  text_nom_site       String? @db.VarChar(100)
  text_background_url String?
  favicon             Media?  @relation("HeaderFavicon")
  logo                Media?  @relation("HeaderLogo")
  reseaux             Media[] @relation("HeaderReseaux")

  @@map("headers")
}

model Footer {
  number_id              Int     @id @default(autoincrement())
  color_background_color String? @db.VarChar(20)
  text_nom_site_adresse  String? @db.VarChar(100)
  text_adresse_footer    String? @db.VarChar(255)
  text_code_postal       String? @db.VarChar(20)
  reseaux                Media[] @relation("FooterReseaux")

  @@map("footers")
}

model Media {
  number_id                Int     @id @default(autoincrement())
  text_titre               String? @db.VarChar(255)
  color_couleur_bg         String? @db.VarChar(20)
  text_image_lien          String?
  number_position_image    Int?
  image_url                String
  number_header_logo_id    Int?    @unique
  number_header_favicon_id Int?    @unique
  number_header_reseaux_id Int?
  number_footer_id         Int?
  footer                   Footer? @relation("FooterReseaux", fields: [number_footer_id], references: [number_id], onDelete: Cascade)
  headerFavicon            Header? @relation("HeaderFavicon", fields: [number_header_favicon_id], references: [number_id], onDelete: Cascade)
  headerLogo               Header? @relation("HeaderLogo", fields: [number_header_logo_id], references: [number_id], onDelete: Cascade)
  headerReseaux            Header? @relation("HeaderReseaux", fields: [number_header_reseaux_id], references: [number_id], onDelete: Cascade)

  @@index([number_header_reseaux_id])
  @@index([number_footer_id])
  @@map("medias")
}
